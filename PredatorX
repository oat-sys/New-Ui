lastSafePosition = Vector3.new()
antiFlingActive = false
antiFlingConnection = nil

function startAntiFling()
    if antiFlingConnection then return end
    
    antiFlingConnection = RunService.Stepped:Connect(function()
        if not antiFlingActive then return end
        
        local character = LocalPlayer.Character
        if not character then return end
        
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        
        if not humanoidRootPart or not humanoid then return end
        
        local origin = humanoidRootPart.Position
        local direction = Vector3.new(0, -5, 0)
        
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {character}
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        
        local ray = workspace:Raycast(origin, direction, raycastParams)
        
        local velocity = humanoidRootPart.AssemblyLinearVelocity
        local currentVelocity = velocity.Magnitude
        
        local horizontalVel = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
        local isJustFalling = (velocity.Y < -40) and (horizontalVel < 20)
        
        if humanoid.FloorMaterial ~= Enum.Material.Air and ray and ray.Instance:IsA("BasePart") and ray.Instance.Anchored then
            lastSafePosition = humanoidRootPart.Position
        elseif currentVelocity >= 60 and not isJustFalling then
            humanoidRootPart.CFrame = CFrame.new(lastSafePosition)
            humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
            humanoidRootPart.AssemblyAngularVelocity = Vector3.zero
        end
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local otherChar = player.Character
                if otherChar then
                    for _, part in ipairs(otherChar:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end
        end
    end)
end

function stopAntiFling()
    if antiFlingConnection then
        antiFlingConnection:Disconnect()
        antiFlingConnection = nil
    end
end

