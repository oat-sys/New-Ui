-- // ────────── DROPDOWN ──────────
function PredatorUI:AddDropdown(group, opts)
    if type(opts) == "string" then opts = { Name = opts } end
    opts = opts or {}

    local name     = opts.Name or "Dropdown"
    local options  = opts.Options or {}
    local default  = opts.Default or options[1]
    local multi    = opts.Multi or false
    local callback = opts.Callback
    local iconId   = parseIcon(opts.Icon)
    local flag     = opts.Flag or name

    local selected = multi and (type(default) == "table" and default or {}) or (type(default) == "table" and default[1] or default)
    self.Flags[flag] = selected

    local card = self:_makeCard(group, 36)

    if iconId then
        self:_makeIcon(card, iconId, Theme.Accent)
    end

    local label = self:_makeLabel(card, name, iconId ~= nil)
    label.Size = UDim2.new(0, 100, 1, 0)

    -- // Select Button
    local btn = create("TextButton", {
        Size = UDim2.new(0, 140, 0, 24),
        Position = UDim2.new(1, -150, 0.5, -12),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.3,
        Text = "",
        AutoButtonColor = false,
        Parent = card,
    })
    corner(btn, 8)
    stroke(btn, Theme.BorderDim, 1, 0.7)

    local btnText = create("TextLabel", {
        Size = UDim2.new(1, -20, 1, 0),
        Position = UDim2.new(0, 10, 0, 0),
        BackgroundTransparency = 1,
        Text = multi and "None" or tostring(default or "None"),
        TextColor3 = Theme.Text,
        Font = Font,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = btn,
    })

    local arrow = create("TextLabel", {
        Size = UDim2.new(0, 20, 1, 0),
        Position = UDim2.new(1, -20, 0, 0),
        BackgroundTransparency = 1,
        Text = "▼",
        TextColor3 = Theme.TextDim,
        Font = Font,
        TextSize = 9,
        Parent = btn,
    })

    -- // Dropdown List (ลอย)
    local list = create("Frame", {
        Size = UDim2.new(0, 140, 0, 0),
        Position = UDim2.new(1, -150, 1, 4),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Visible = false,
        ZIndex = 50,
        Parent = card,
    })
    corner(list, 10)
    stroke(list, Theme.BorderDim, 1, 0.4)

    local listLayout = create("UIListLayout", {
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = list,
    })
    padding(list, 5)

    local expanded = false

    local function updateText()
        if multi then
            if type(selected) == "table" and #selected > 0 then
                if #selected == 1 then
                    btnText.Text = selected[1]
                else
                    btnText.Text = #selected .. " selected"
                end
            else
                btnText.Text = "None"
            end
        else
            btnText.Text = tostring(selected or "None")
        end
    end

    local function renderList()
        for _, c in ipairs(list:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end

        for _, opt in ipairs(options) do
            local isSel = multi and (type(selected) == "table" and table.find(selected, opt)) or (selected == opt)

            local optBtn = create("TextButton", {
                Size = UDim2.new(1, 0, 0, 26),
                BackgroundColor3 = isSel and Theme.Accent or Color3.fromRGB(255, 255, 255),
                BackgroundTransparency = isSel and 0.85 or 1,
                Text = "",
                AutoButtonColor = false,
                Parent = list,
            })
            corner(optBtn, 6)

            create("TextLabel", {
                Size = UDim2.new(1, -16, 1, 0),
                Position = UDim2.new(0, 10, 0, 0),
                BackgroundTransparency = 1,
                Text = opt,
                TextColor3 = isSel and Theme.Accent or Theme.Text,
                Font = isSel and FontBold or Font,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = optBtn,
            })

            optBtn.MouseEnter:Connect(function()
                if not isSel then
                    tween(optBtn, 0.1, {BackgroundTransparency = 0.9})
                end
            end)
            optBtn.MouseLeave:Connect(function()
                if not isSel then
                    tween(optBtn, 0.1, {BackgroundTransparency = 1})
                end
            end)

            optBtn.MouseButton1Click:Connect(function()
                if multi then
                    selected = type(selected) == "table" and selected or {}
                    local idx = table.find(selected, opt)
                    if idx then
                        table.remove(selected, idx)
                    else
                        table.insert(selected, opt)
                    end
                    self.Flags[flag] = selected
                    updateText()
                    renderList()
                    if callback then task.spawn(callback, selected) end
                else
                    selected = opt
                    self.Flags[flag] = opt
                    updateText()
                    renderList()
                    -- ปิด list
                    expanded = false
                    tween(list, 0.15, {Size = UDim2.new(0, 140, 0, 0)})
                    task.wait(0.15)
                    list.Visible = false
                    if callback then task.spawn(callback, opt) end
                end
            end)
        end
    end

    btn.MouseButton1Click:Connect(function()
        expanded = not expanded
        if expanded then
            renderList()
            list.Visible = true
            local targetH = math.min(#options * 28 + 12, 200)
            tween(list, 0.2, {Size = UDim2.new(0, 140, 0, targetH)})
        else
            tween(list, 0.15, {Size = UDim2.new(0, 140, 0, 0)})
            task.wait(0.15)
            list.Visible = false
        end
    end)

    updateText()

    return {
        Frame = card,
        Set = function(v)
            if multi then
                selected = v
            else
                selected = v
            end
            self.Flags[flag] = selected
            updateText()
            renderList()
        end,
        Get = function() return selected end,
    }
end

