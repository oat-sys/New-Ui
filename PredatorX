-- CreateTab({ Name = "Main", Icon = 12345678 })
function PredatorUI:CreateTab(opts)
    if type(opts) == "string" then
        opts = { Name = opts }
    end
    opts = opts or {}

    local tab = {
        Name    = opts.Name or "Tab",
        Icon    = parseIcon(opts.Icon) or "rbxassetid://6031094678",
        Window  = self,
        Groups  = {},
    }

    -- // Tab Button
    tab.Button = create("TextButton", {
        Name = tab.Name,
        Size = UDim2.new(0, 44, 0, 44),
        BackgroundColor3 = Theme.CardBg,
        BackgroundTransparency = 0.7,
        Text = "",
        AutoButtonColor = false,
        Parent = self.TabBar,
    })
    corner(tab.Button, 12)

    -- // Icon
    tab.IconLabel = create("ImageLabel", {
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(0.5, -10, 0.5, -10),
        BackgroundTransparency = 1,
        Image = tab.Icon,
        ImageColor3 = Theme.TextDim,
        Parent = tab.Button,
    })

    -- // Active Indicator
    tab.Indicator = create("Frame", {
        Size = UDim2.new(0, 3, 0.6, 0),
        Position = UDim2.new(0, -8, 0.2, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Visible = false,
        Parent = tab.Button,
    })
    corner(tab.Indicator, 2)
    gradient(tab.Indicator, Theme.Accent, Theme.AccentAlt, 90)

    -- // Page
    tab.Page = create("Frame", {
        Name = tab.Name .. "Page",
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Visible = false,
        Parent = self.Layout,
    })

    create("UIListLayout", {
        Padding = UDim.new(0, 10),
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = tab.Page,
    })

    -- // Hover
    tab.Button.MouseEnter:Connect(function()
        if self.ActiveTab ~= tab then
            tween(tab.Button, 0.15, {BackgroundTransparency = 0.5})
            tween(tab.IconLabel, 0.15, {ImageColor3 = Theme.Accent})
        end
    end)
    tab.Button.MouseLeave:Connect(function()
        if self.ActiveTab ~= tab then
            tween(tab.Button, 0.15, {BackgroundTransparency = 0.7})
            tween(tab.IconLabel, 0.15, {ImageColor3 = Theme.TextDim})
        end
    end)

    -- // Click
    tab.Button.MouseButton1Click:Connect(function()
        self:SelectTab(tab)
    end)

    table.insert(self.Tabs, tab)

    if not self.ActiveTab then
        self:SelectTab(tab)
    end

    return tab
end

function PredatorUI:SelectTab(tab)
    if self.ActiveTab == tab then return end

    for _, t in ipairs(self.Tabs) do
        t.Page.Visible = false
        t.Indicator.Visible = false
        tween(t.Button, 0.15, {
            BackgroundColor3 = Theme.CardBg,
            BackgroundTransparency = 0.7,
        })
        tween(t.IconLabel, 0.15, {ImageColor3 = Theme.TextDim})
    end

    self.ActiveTab = tab
    tab.Page.Visible = true
    tab.Indicator.Visible = true
    tween(tab.Button, 0.15, {
        BackgroundColor3 = Theme.TabActiveBg,
        BackgroundTransparency = Transparency.TabActiveBg,
    })
    tween(tab.IconLabel, 0.15, {ImageColor3 = Theme.Accent})
end

