-- ▓▓▓ UTILS ▓▓▓
-- ═══════════════════════════════════════════════════════════════
local function create(class, props)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do
        inst[k] = v
    end
    return inst
end

local function tween(obj, time, props, style, dir)
    local info = TweenInfo.new(
        time or 0.2,
        style or Enum.EasingStyle.Quart,
        dir or Enum.EasingDirection.Out
    )
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local function corner(parent, radius)
    return create("UICorner", {
        CornerRadius = UDim.new(0, radius or 10),
        Parent = parent,
    })
end

local function stroke(parent, color, thickness, transparency)
    return create("UIStroke", {
        Color = color or Theme.Border,
        Thickness = thickness or 1,
        Transparency = transparency or Transparency.Border,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

local function padding(parent, all, l, r, t, b)
    return create("UIPadding", {
        PaddingLeft   = UDim.new(0, l or all or 0),
        PaddingRight  = UDim.new(0, r or all or 0),
        PaddingTop    = UDim.new(0, t or all or 0),
        PaddingBottom = UDim.new(0, b or all or 0),
        Parent = parent,
    })
end

local function gradient(parent, c1, c2, rot)
    return create("UIGradient", {
        Color = ColorSequence.new(c1, c2),
        Rotation = rot or 135,
        Parent = parent,
    })
end

-- ✅ ไอคอนแบบ Roblox Asset ID
-- ใช้ได้เลย โดยใส่เป็น number หรือ string "rbxassetid://xxxxx"
local function parseIcon(id)
    if type(id) == "number" then
        return "rbxassetid://" .. tostring(id)
    elseif type(id) == "string" then
        if id:find("rbxassetid://") or id:find("rbxasset://") or id:find("http") then
            return id
        end
        return "rbxassetid://" .. id
    end
    return nil
end

