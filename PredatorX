WhitelistUsers = {}
WhitelistEnabled = false
AutoWhitelistFriends = false
WhitelistListLabel = nil
WhitelistDropdown = nil
WhitelistFriendConn = nil


_G.isWhitelisted = function(player)
    if not WhitelistEnabled then
        return false
    end
    if not player or not player.Name then
        return false
    end
    return WhitelistUsers[player.Name] == true
end


getAllPlayers = function()
    local players = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            if not _G.isWhitelisted(plr) then
                table.insert(players, plr)
            end
        end
    end
    return players
end


function GetWhitelistPlayerList()
    local list = {}
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local displayName = plr.DisplayName or plr.Name
            local label = displayName .. " (@" .. plr.Name .. ")"
            if WhitelistUsers[plr.Name] then
                label = "[WL] " .. label
            end
            table.insert(list, label)
        end
    end
    table.sort(list)
    return list
end


function UpdateWhitelistLabel()
    local names = {}
    for name, _ in pairs(WhitelistUsers) do
        table.insert(names, name)
    end
    table.sort(names)
    if WhitelistListLabel then
        WhitelistListLabel:SetText("<b>Whitelisted:</b> " .. (#names > 0 and table.concat(names, ", ") or "None"))
    end
end


function RefreshWhitelistDropdown()
    if WhitelistDropdown then
        WhitelistDropdown:SetValues(GetWhitelistPlayerList())
    end
end


