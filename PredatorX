end

function PredatorUI:_makeIcon(card, iconId, color)
    if not iconId then return end
    return create("ImageLabel", {
        Size = UDim2.new(0, 15, 0, 15),
        Position = UDim2.new(0, 10, 0.5, -7.5),
        BackgroundTransparency = 1,
        Image = iconId,
        ImageColor3 = color or Theme.Accent,
        Parent = card,
    })
end

function PredatorUI:_makeLabel(card, text, hasIcon)
    return create("TextLabel", {
        Size = UDim2.new(1, hasIcon and -50 or -30, 1, 0),
        Position = UDim2.new(0, hasIcon and 32 or 12, 0, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = Theme.Text,
        Font = Font,
        TextSize = 12.5,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = card,
    })
end

