    local name     = opts.Name or "Keybind"
    local default  = opts.Default or Enum.KeyCode.Unknown
    local callback = opts.Callback
    local iconId   = parseIcon(opts.Icon)
    local flag     = opts.Flag or name

    local card = self:_makeCard(group, 36)

    if iconId then
        self:_makeIcon(card, iconId, Theme.Accent)
    end

    self:_makeLabel(card, name, iconId ~= nil)

    local keyBtn = create("TextButton", {
        Size = UDim2.new(0, 90, 0, 24),
        Position = UDim2.new(1, -100, 0.5, -12),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.3,
        Text = default.Name,
        TextColor3 = Theme.Text,
        Font = FontBold,
        TextSize = 11,
        AutoButtonColor = false,
        Parent = card,
    })
    corner(keyBtn, 8)
    stroke(keyBtn, Theme.BorderDim, 1, 0.7)

    local currentKey = default
    local listening = false
    local keyConn

    keyBtn.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        keyBtn.Text = "..."
        tween(keyBtn, 0.15, {
            BackgroundColor3 = Theme.Accent,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            BackgroundTransparency = 0.1,
        })

        keyConn = UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            if input.UserInputType == Enum.UserInputType.Keyboard then
                currentKey = input.KeyCode
                self.Flags[flag] = currentKey
                keyBtn.Text = currentKey.Name
                listening = false
                tween(keyBtn, 0.15, {
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    TextColor3 = Theme.Text,
                    BackgroundTransparency = 0.3,
                })
                if callback then task.spawn(callback, currentKey) end
                if keyConn then keyConn:Disconnect() keyConn = nil end
            end
        end)
    end)

    return {
        Frame = card,
        Get = function() return currentKey end,
        Set = function(k)
            currentKey = k
            keyBtn.Text = k.Name
        end,
    }
end

