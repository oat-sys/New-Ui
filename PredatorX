function UpdateTargetInfo()
    if infoUpdateTask then
        task.cancel(infoUpdateTask)
        infoUpdateTask = nil
    end
    
    if not SelectedTarget then
        if avatarImage then
            avatarImage:SetImage("rbxassetid://0")
        end
        statusLabel:SetText("<b> Status: No Target </b>")
        distanceLabel:SetText("<b> Distance: N/A </b>")
        aliveLabel:SetText("<b> Alive: N/A </b>")
        return
    end
    
    local ok, avatarUrl = pcall(function()
        return Players:GetUserThumbnailAsync(SelectedTarget.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
    end)
    
    if ok and avatarUrl then
        if avatarImage then
            avatarImage:SetImage(avatarUrl)
        end
    end
    
    infoUpdateTask = task.spawn(function()
        while true do
            if not SelectedTarget or not SelectedTarget.Parent then
                if avatarImage then
                    avatarImage:SetImage("rbxassetid://0")
                end
                statusLabel:SetText("<b> Status: <font color='rgb(255,150,50)'>Not In Server</font> </b>")
                distanceLabel:SetText("<b> Distance: N/A </b>")
                aliveLabel:SetText("<b> Alive: N/A </b>")
                SelectedTarget = nil
                break
            end
            
            local shouldBreak = false
            
            pcall(function()
                local char = SelectedTarget.Character
                
                if char then
                    local hum = char:FindFirstChild("Humanoid")
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    
                    if hum then
                        local health = hum.Health
                        
                        if health <= 0 then
                            statusLabel:SetText("<b> Status: In Server </b>")
                            aliveLabel:SetText("<b> Alive: <font color='rgb(255,50,50)'>No</font> </b>")
                        else
                            statusLabel:SetText("<b> Status: In Server </b>")
                            aliveLabel:SetText("<b> Alive: <font color='rgb(50,255,50)'>Yes</font> </b>")
                        end
                    end
                    
                    if hrp and LocalPlayer.Character then
                        local myHRP = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                        if myHRP then
                            local dist = math.floor((hrp.Position - myHRP.Position).Magnitude)
                            distanceLabel:SetText("<b> Distance: " .. dist .. " studs </b>")
                        end
                    end
                else
                    if SelectedTarget.Parent then
                        statusLabel:SetText("<b> Status: <font color='rgb(255,150,50)'>Loading...</font> </b>")
                        distanceLabel:SetText("<b> Distance: N/A </b>")
                        aliveLabel:SetText("<b> Alive: N/A </b>")
                    else
                        statusLabel:SetText("<b> Status: <font color='rgb(255,150,50)'>Not In Server</font> </b>")
                        distanceLabel:SetText("<b> Distance: N/A </b>")
                        aliveLabel:SetText("<b> Alive: N/A </b>")
                        shouldBreak = true
                    end
                end
            end)
            
            if shouldBreak then
                SelectedTarget = nil
                break
            end
            
            task.wait(0.5)
        end
    end)
end

