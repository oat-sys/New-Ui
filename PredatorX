    stroke(btn, Theme.BorderDim, 1, 0.7)
    padding(btn, 4, 4, 4, 4, 4)

    local swatch = create("Frame", {
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(0, 4, 0.5, -8),
        BackgroundColor3 = default,
        BorderSizePixel = 0,
        Parent = btn,
    })
    corner(swatch, 5)
    stroke(swatch, Theme.Border, 1, 0.3)

    local hexLabel = create("TextLabel", {
        Size = UDim2.new(1, -24, 1, 0),
        Position = UDim2.new(0, 24, 0, 0),
        BackgroundTransparency = 1,
        Text = string.format("#%02X%02X%02X",
            math.floor(default.R*255),
            math.floor(default.G*255),
            math.floor(default.B*255)),
        TextColor3 = Theme.TextDim,
        Font = FontBold,
        TextSize = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = btn,
    })

    local currentColor = default

    -- // Popover
    local popover = create("Frame", {
        Size = UDim2.new(0, 240, 0, 260),
        Position = UDim2.new(1, -250, 1, 4),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 60,
        Parent = card,
    })
    corner(popover, 12)
    stroke(popover, Theme.BorderDim, 1, 0.4)
    padding(popover, 10)

    -- // Preview
    local preview = create("Frame", {
        Size = UDim2.new(1, -20, 0, 40),
        Position = UDim2.new(0, 10, 0, 10),
        BackgroundColor3 = default,
        BorderSizePixel = 0,
        Parent = popover,
    })
    corner(preview, 8)

    local previewText = create("TextLabel", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = string.format("#%02X%02X%02X",
            math.floor(default.R*255),
            math.floor(default.G*255),
            math.floor(default.B*255)),
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = FontBold,
        TextSize = 11,
        Parent = preview,
    })

    -- // Presets
    local PRESETS = {
        Color3.fromRGB(88, 101, 242),
        Color3.fromRGB(140, 80, 255),
        Color3.fromRGB(236, 72, 153),
        Color3.fromRGB(239, 68, 68),
        Color3.fromRGB(245, 158, 11),
        Color3.fromRGB(234, 179, 8),
        Color3.fromRGB(16, 185, 129),
        Color3.fromRGB(6, 182, 212),
        Color3.fromRGB(59, 130, 246),
        Color3.fromRGB(100, 116, 139),
        Color3.fromRGB(30, 30, 40),
        Color3.fromRGB(255, 255, 255),
    }

    local presetGrid = create("Frame", {
        Size = UDim2.new(1, -20, 0, 50),
        Position = UDim2.new(0, 10, 0, 58),
        BackgroundTransparency = 1,
        Parent = popover,
    })
    create("UIGridLayout", {
        CellSize = UDim2.new(0, 26, 0, 20),
        CellPadding = UDim2.new(0, 5, 0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = presetGrid,
    })

    local function updateDisplay()
        swatch.BackgroundColor3 = currentColor
        preview.BackgroundColor3 = currentColor
        local hex = string.format("#%02X%02X%02X",
            math.floor(currentColor.R*255),
            math.floor(currentColor.G*255),
            math.floor(currentColor.B*255))
        hexLabel.Text = hex
        previewText.Text = hex
        self.Flags[flag] = currentColor
        if callback then task.spawn(callback, currentColor) end
    end

    for _, color in ipairs(PRESETS) do
        local p = create("TextButton", {
            Size = UDim2.new(0, 26, 0, 20),
            BackgroundColor3 = color,
            Text = "",
            AutoButtonColor = false,
            Parent = presetGrid,
        })
        corner(p, 6)
        stroke(p, Theme.Border, 1, 0.5)

        p.MouseButton1Click:Connect(function()
            currentColor = color
            updateDisplay()
        end)
    end

    -- // RGB Sliders
    local rgbSliders = {}
    local function makeRGBSlider(labelTxt, posY, colorKey)
        local holder = create("Frame", {
            Size = UDim2.new(1, -20, 0, 22),
            Position = UDim2.new(0, 10, 0, posY),
            BackgroundTransparency = 1,
            Parent = popover,
        })

        create("TextLabel", {
            Size = UDim2.new(0, 14, 1, 0),
            BackgroundTransparency = 1,
            Text = labelTxt,
            TextColor3 = Theme.TextDim,
            Font = FontBold,
            TextSize = 10,
            Parent = holder,
        })

        local track = create("Frame", {
            Size = UDim2.new(1, -22, 0, 5),
            Position = UDim2.new(0, 20, 0.5, -2.5),
            BackgroundColor3 = colorKey == "R" and Color3.fromRGB(255, 200, 200)
                or colorKey == "G" and Color3.fromRGB(200, 255, 200)
                or Color3.fromRGB(200, 200, 255),
            BorderSizePixel = 0,
            Parent = holder,
        })
        corner(track, 3)

        local val = currentColor[colorKey]
        local fill = create("Frame", {
            Size = UDim2.new(val, 0, 1, 0),
            BackgroundColor3 = Theme.Accent,
            BorderSizePixel = 0,
            Parent = track,
        })
        corner(fill, 3)

        local knob = create("Frame", {
            Size = UDim2.new(0, 10, 0, 10),
            Position = UDim2.new(val, -5, 0.5, -5),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BorderSizePixel = 0,
            Parent = track,
        })
        corner(knob, 5)
        stroke(knob, Theme.Accent, 1.5, 0)

        local dragging = false
        local function updateColor(input)
            local pos = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            fill.Size = UDim2.new(pos, 0, 1, 0)
            knob.Position = UDim2.new(pos, -5, 0.5, -5)

            local c = Color3.new(currentColor.R, currentColor.G, currentColor.B)
            c = Color3.new(
                colorKey == "R" and pos or c.R,
                colorKey == "G" and pos or c.G,
                colorKey == "B" and pos or c.B
            )
            currentColor = c
            updateDisplay()
        end

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                updateColor(input)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
                updateColor(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    makeRGBSlider("R", 118, "R")
    makeRGBSlider("G", 146, "G")
    makeRGBSlider("B", 174, "B")

    btn.MouseButton1Click:Connect(function()
        popover.Visible = not popover.Visible
    end)

    updateDisplay()

    return {
        Frame = card,
        Set = function(c)
            currentColor = c
            updateDisplay()
        end,
        Get = function() return currentColor end,
    }
end

