function StyleMenuUI()
    player = game:GetService("Players").LocalPlayer
    playerGui = player:WaitForChild("PlayerGui")
    menuGui = playerGui:WaitForChild("MenuGui")
    menu = menuGui:WaitForChild("Menu")

    black = Color3.fromRGB(8, 10, 16)
    dark = Color3.fromRGB(18, 16, 14)
    gold = Color3.fromRGB(255, 215, 0)
    goldLight = Color3.fromRGB(255, 235, 150)
    goldDark = Color3.fromRGB(200, 160, 0)
    white = Color3.fromRGB(255, 255, 255)
    cream = Color3.fromRGB(255, 245, 230)
    cornerRadius = UDim.new(0, 12)
    
    function roundCorners(obj)
        local corner = obj:FindFirstChildOfClass("UICorner")
        if corner then
            corner.CornerRadius = cornerRadius
        else
            corner = Instance.new("UICorner")
            corner.CornerRadius = cornerRadius
            corner.Parent = obj
        end
    end
    
    function addGoldGradient(obj, rotation)
        local gradient = obj:FindFirstChildOfClass("UIGradient")
        if not gradient then
            gradient = Instance.new("UIGradient")
        end
        gradient.Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0, goldDark),
            ColorSequenceKeypoint.new(0.2, goldLight),
            ColorSequenceKeypoint.new(0.5, gold),
            ColorSequenceKeypoint.new(0.8, goldLight),
            ColorSequenceKeypoint.new(1, goldDark)
        }
        gradient.Rotation = rotation or 45
        gradient.Parent = obj
    end
    
    function addGoldStroke(obj, thickness, transparency)
        local stroke = obj:FindFirstChildOfClass("UIStroke")
        if not stroke then
            stroke = Instance.new("UIStroke")
        end
        stroke.Color = gold
        stroke.Thickness = thickness or 1.5
        stroke.Transparency = transparency or 0.5
        stroke.Parent = obj
        return stroke
    end

    tabBarSizeY = 0.9999

    tabBar = menu:WaitForChild("TabBar")
    tabBar.BackgroundColor3 = black
    tabBar.BackgroundTransparency = 0.2
    tabBar.Size = UDim2.new(tabBar.Size.X.Scale, tabBar.Size.X.Offset, tabBarSizeY, tabBar.Size.Y.Offset)
    roundCorners(tabBar)
    addGoldStroke(tabBar, 1, 0.6)

    tabContents = menu:WaitForChild("TabContents")
    for _, frame in ipairs(tabContents:GetChildren()) do
        if frame:IsA("Frame") then
            frame.BackgroundColor3 = black
            frame.BackgroundTransparency = 0.65
            roundCorners(frame)
            addGoldStroke(frame, 1, 0.4)

            title = frame:FindFirstChild("Title")
            if title then
                title.BackgroundColor3 = dark
                title.BackgroundTransparency = 0.3
                roundCorners(title)
                addGoldStroke(title, 1, 0.3)
                
                local currentSize = title.Size
                title.Size = UDim2.new(currentSize.X.Scale * 0.975, currentSize.X.Offset, currentSize.Y.Scale, currentSize.Y.Offset)
                
                local titleGrad = title:FindFirstChildOfClass("UIGradient")
                if not titleGrad then
                    titleGrad = Instance.new("UIGradient")
                end
                titleGrad.Color = ColorSequence.new{
                    ColorSequenceKeypoint.new(0, goldDark),
                    ColorSequenceKeypoint.new(0.5, goldLight),
                    ColorSequenceKeypoint.new(1, goldDark)
                }
                titleGrad.Rotation = 90
                titleGrad.Parent = title
            end

            sortingTabs = frame:FindFirstChild("SortingTabs")
            if sortingTabs then
                sortingTabs.BackgroundColor3 = dark
                sortingTabs.BackgroundTransparency = 0.4
                roundCorners(sortingTabs)
                addGoldStroke(sortingTabs, 1, 0.3)
            end

            contents = frame:FindFirstChild("Contents")
            if contents then
                contents.BackgroundColor3 = Color3.fromRGB(25, 22, 18)
                contents.BackgroundTransparency = 0.5
                roundCorners(contents)
                addGoldGradient(contents, 45)
                addGoldStroke(contents, 1.5, 0.3)

                contents.ChildAdded:Connect(function()
                    contents.BackgroundTransparency = 0
                    TweenService:Create(contents, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        BackgroundTransparency = 0.5
                    }):Play()
                end)
            end

            favoritesFrame = frame:FindFirstChild("FavoritesFrame")
            if favoritesFrame then
                favoritesFrame.BackgroundColor3 = black
                favoritesFrame.BackgroundTransparency = 0.8
                roundCorners(favoritesFrame)
                addGoldStroke(favoritesFrame, 1, 0.3)
            end

            if contents then
                for _, item in ipairs(contents:GetChildren()) do
                    local fav = item:FindFirstChild("Favorite")
                    if fav and (fav:IsA("ImageLabel") or fav:IsA("ImageButton")) then
                        fav.ImageTransparency = 1
                        fav.BackgroundTransparency = 1
                    end
                end
            end
        end
    end

    for _, desc in ipairs(menuGui:GetDescendants()) do
        if desc.Name == "MeterFrame" and desc:IsA("GuiObject") then
            desc.BackgroundColor3 = dark
            desc.BackgroundTransparency = 0.3
            roundCorners(desc)
            addGoldStroke(desc, 1, 0.4)
        end
    end
end

