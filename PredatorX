-- ▓▓▓ FLOATING TOGGLE BUTTON (Crown + ลากได้) ▓▓▓
-- ═══════════════════════════════════════════════════════════════
function PredatorUI:CreateFloatingButton(opts)
    opts = opts or {}
    local iconId   = parseIcon(opts.Icon) or "rbxassetid://7733960979"
    local position = opts.Position or UDim2.new(0, 20, 0, 100)
    local size     = opts.Size or UDim2.new(0, 56, 0, 56)

    local fb = {}

    -- // ปุ่มหลัก
    fb.Button = create("TextButton", {
        Name = "PredatorUI_Toggle",
        Size = size,
        Position = position,
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.7,
        Text = "",
        AutoButtonColor = false,
        Parent = self.Gui,
    })
    corner(fb.Button, 18)
    stroke(fb.Button, Theme.Border, 1.5, 0.4)

    -- // 👑 Crown Icon
    fb.Icon = create("ImageLabel", {
        Size = UDim2.new(0, 26, 0, 26),
        Position = UDim2.new(0.5, -13, 0.5, -13),
        BackgroundTransparency = 1,
        Image = iconId,
        ImageColor3 = Theme.Gold,
        Parent = fb.Button,
    })

    -- // สถานะ
    fb.Active = true
    fb.Position = position

    -- ═══ ฟังก์ชันอัปเดตสถานะ ═══
    local function updateVisual()
        if fb.Active then
            tween(fb.Button, 0.2, {BackgroundTransparency = 0.05})
            tween(fb.Button, 0.2, {BackgroundColor3 = Theme.Gold})
            fb.Icon.ImageColor3 = Color3.fromRGB(255, 255, 255)
        else
            tween(fb.Button, 0.2, {BackgroundTransparency = 0.7})
            tween(fb.Button, 0.2, {BackgroundColor3 = Color3.fromRGB(255, 255, 255)})
            fb.Icon.ImageColor3 = Theme.Gold
        end
    end

    -- ═══ ระบบลาก (Draggable) ═══
    local dragging = false
    local dragStart, startPos
    local moved = false

    fb.Button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            moved = false
            dragStart = input.Position
            startPos = fb.Button.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
        and input.UserInputType ~= Enum.UserInputType.Touch then return end

        local delta = input.Position - dragStart
        if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
            moved = true
        end

        fb.Button.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            if dragging and not moved then
                -- คลิกปกติ → toggle UI
                fb.Active = not fb.Active
                self:Toggle()
                updateVisual()
            end
            dragging = false
        end
    end)

    -- // Hover
    fb.Button.MouseEnter:Connect(function()
        if not fb.Active then
            tween(fb.Button, 0.15, {BackgroundTransparency = 0.5})
        end
    end)
    fb.Button.MouseLeave:Connect(function()
        if not fb.Active then
            tween(fb.Button, 0.15, {BackgroundTransparency = 0.7})
        end
    end)

    -- // ซ่อนเมื่อกด RightShift ด้วย (sync กับ Window)
    local origToggle = self.Toggle
    self.Toggle = function(self2)
        origToggle(self2)
        fb.Active = self.IsOpen
        updateVisual()
    end

    updateVisual()
    return fb
end
