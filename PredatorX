WhitelistGroup:AddCheckbox("AutoWhitelistFriends", {
    Text = "Auto Whitelist Friends",
    Default = false,
    Callback = function(Value)
        AutoWhitelistFriends = Value

        if Value then
            -- เช็คเพื่อนที่มีอยู่ในเซิฟก่อน
            task.spawn(function()
                for _, plr in pairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer then
                        local ok, isFriend = pcall(function()
                            return LocalPlayer:IsFriendsWith(plr.UserId)
                        end)
                        if ok and isFriend and not WhitelistUsers[plr.Name] then
                            WhitelistUsers[plr.Name] = true
                            Library:Notify({
                                Title = "PredatorX",
                                Description = "Auto-whitelisted friend: " .. plr.DisplayName,
                                Icon = "rbxassetid://116176143011396",
                                Duration = 3
                            })
                        end
                    end
                end
                UpdateWhitelistLabel()
                RefreshWhitelistDropdown()
            end)

            -- เชื่อม event เมื่อเพื่อนเข้าเซิฟใหม่
            if WhitelistFriendConn then
                WhitelistFriendConn:Disconnect()
            end

            WhitelistFriendConn = Players.PlayerAdded:Connect(function(plr)
                if not AutoWhitelistFriends then return end
                if plr == LocalPlayer then return end

                task.wait(0.5)

                local ok, isFriend = pcall(function()
                    return LocalPlayer:IsFriendsWith(plr.UserId)
                end)

                if ok and isFriend and not WhitelistUsers[plr.Name] then
                    WhitelistUsers[plr.Name] = true
                    Library:Notify({
                        Title = "PredatorX",
                        Description = "Auto-whitelisted friend: " .. plr.DisplayName,
                        Icon = "rbxassetid://116176143011396",
                        Duration = 5
                    })
                    UpdateWhitelistLabel()
                    RefreshWhitelistDropdown()
                end
            end)
        else
            if WhitelistFriendConn then
                WhitelistFriendConn:Disconnect()
                WhitelistFriendConn = nil
            end
        end
    end
})

