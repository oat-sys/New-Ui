-- ▓▓▓ WATERMARK (FPS / Ping / Time) ▓▓▓
-- ═══════════════════════════════════════════════════════════════
function PredatorUI:CreateWatermark(opts)
    opts = opts or {}
    local name     = opts.Name or "PredatorX"
    local iconId   = parseIcon(opts.Icon) or "rbxassetid://7733960979"
    local showFPS  = opts.ShowFPS ~= false
    local showPing = opts.ShowPing ~= false
    local showTime = opts.ShowTime ~= false
    local position = opts.Position or UDim2.new(0.5, -180, 0, 20)

    local wm = {}

    -- // Container
    wm.Frame = create("Frame", {
        Name = "Watermark",
        Size = UDim2.new(0, 360, 0, 40),
        Position = position,
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.88,
        BorderSizePixel = 0,
        Parent = self.Gui,
    })
    corner(wm.Frame, 12)
    stroke(wm.Frame, Theme.Border, 1, 0.7)

    create("UIListLayout", {
        Padding = UDim.new(0, 14),
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        Parent = wm.Frame,
    })

    -- // ── Brand ──
    local brand = create("Frame", {
        Size = UDim2.new(0, 110, 1, 0),
        BackgroundTransparency = 1,
        Parent = wm.Frame,
    })

    -- 👑 Crown Icon
    create("ImageLabel", {
        Size = UDim2.new(0, 20, 0, 20),
        Position = UDim2.new(0, 10, 0.5, -10),
        BackgroundTransparency = 1,
        Image = iconId,
        ImageColor3 = Theme.Gold,
        Parent = brand,
    })

    create("TextLabel", {
        Size = UDim2.new(1, -40, 1, 0),
        Position = UDim2.new(0, 34, 0, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = Theme.Text,
        Font = FontBold,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = brand,
    })

    -- // ── Divider ──
    create("Frame", {
        Size = UDim2.new(0, 1, 0.5, 0),
        Position = UDim2.new(0, 0, 0.25, 0),
        BackgroundColor3 = Theme.BorderDim,
        BackgroundTransparency = 0.6,
        BorderSizePixel = 0,
        Parent = brand,
    })

    -- // ── FPS ──
    if showFPS then
        local fpsBox = create("Frame", {
            Size = UDim2.new(0, 60, 1, 0),
            BackgroundTransparency = 1,
            Parent = wm.Frame,
        })

        create("TextLabel", {
            Size = UDim2.new(0, 30, 1, 0),
            BackgroundTransparency = 1,
            Text = "FPS",
            TextColor3 = Theme.TextFaint,
            Font = FontBold,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = fpsBox,
        })

        wm.FPSLabel = create("TextLabel", {
            Size = UDim2.new(0, 30, 1, 0),
            Position = UDim2.new(0, 30, 0, 0),
            BackgroundTransparency = 1,
            Text = "60",
            TextColor3 = Theme.Success,
            Font = FontBold,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = fpsBox,
        })
    end

    -- // ── Ping ──
    if showPing then
        local pingBox = create("Frame", {
            Size = UDim2.new(0, 70, 1, 0),
            BackgroundTransparency = 1,
            Parent = wm.Frame,
        })

        create("TextLabel", {
            Size = UDim2.new(0, 36, 1, 0),
            BackgroundTransparency = 1,
            Text = "Ping",
            TextColor3 = Theme.TextFaint,
            Font = FontBold,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = pingBox,
        })

        wm.PingLabel = create("TextLabel", {
            Size = UDim2.new(0, 34, 1, 0),
            Position = UDim2.new(0, 36, 0, 0),
            BackgroundTransparency = 1,
            Text = "24ms",
            TextColor3 = Theme.Success,
            Font = FontBold,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = pingBox,
        })
    end

    -- // ── Time ──
    if showTime then
        wm.TimeLabel = create("TextLabel", {
            Size = UDim2.new(0, 70, 1, 0),
            BackgroundTransparency = 1,
            Text = "00:00:00",
            TextColor3 = Theme.Text,
            Font = FontBold,
            TextSize = 12,
            Parent = wm.Frame,
        })
    end

    -- ═══ Logic: FPS ═══
    if showFPS then
        local frameCount = 0
        local lastUpdate = tick()

        local fpsConn
        fpsConn = RunService.RenderStepped:Connect(function()
            frameCount = frameCount + 1
            local now = tick()
            if now - lastUpdate >= 0.5 then
                local fps = math.floor(frameCount / (now - lastUpdate) + 0.5)
                wm.FPSLabel.Text = tostring(fps)

                if fps >= 50 then
                    wm.FPSLabel.TextColor3 = Theme.Success
                elseif fps >= 30 then
                    wm.FPSLabel.TextColor3 = Theme.Warning
                else
                    wm.FPSLabel.TextColor3 = Theme.Danger
                end

                frameCount = 0
                lastUpdate = now
            end
        end)
        table.insert(self.Connections, fpsConn)
    end

    -- ═══ Logic: Ping ═══
    if showPing then
        local pingConn
        pingConn = RunService.Heartbeat:Connect(function()
            task.wait() -- ให้มี delay ก่อนวัดครั้งถัดไป
            local ping = math.floor(LocalPlayer:GetNetworkPing() * 1000 + 0.5)
            wm.PingLabel.Text = tostring(ping) .. "ms"

            if ping < 40 then
                wm.PingLabel.TextColor3 = Theme.Success
            elseif ping < 80 then
                wm.PingLabel.TextColor3 = Theme.Warning
            else
                wm.PingLabel.TextColor3 = Theme.Danger
            end
        end)
        table.insert(self.Connections, pingConn)
    end

    -- ═══ Logic: Time ═══
    if showTime then
        local timeConn
        timeConn = RunService.Heartbeat:Connect(function()
            task.wait(1)
            local t = os.date("*t")
            wm.TimeLabel.Text = string.format("%02d:%02d:%02d", t.hour, t.min, t.sec)
        end)
        table.insert(self.Connections, timeConn)
    end

    return wm
end

