function startLoopKickBlob(target)
    kickLoopEnabled = true
    if not target then kickLoopEnabled = false return end
    task.spawn(function()
        local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then kickLoopEnabled = false return end
        local savedPos = myRoot.CFrame
        local dragging = false
        local grabStartTime = 0
        while kickLoopEnabled and _G.BlobApplyActive do
            if not target or not target.Parent or not target.Character then kickLoopEnabled = false break end
            local tChar = target.Character
            local tRoot = tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar:FindFirstChild("Humanoid")
            local myChar2 = LocalPlayer.Character
            if not myChar2 then task.wait(0.5) continue end
            local myRoot2 = myChar2:FindFirstChild("HumanoidRootPart")
            local seat = myChar2.Humanoid and myChar2.Humanoid.SeatPart
            if tRoot and tHum and tHum.Health > 0 then
                tRoot.AssemblyLinearVelocity = Vector3.zero
                tRoot.Velocity = Vector3.zero
                if seat then
                    local blobman = seat.Parent
                    local remoteFolder = blobman:FindFirstChild("BlobmanSeatAndOwnerScript")
                    local grab = remoteFolder and remoteFolder:FindFirstChild("CreatureGrab")
                    local drop = remoteFolder and remoteFolder:FindFirstChild("CreatureDrop")
                    local L_Det = blobman:FindFirstChild("LeftDetector")
                    local R_Det = blobman:FindFirstChild("RightDetector")
                    local L_Weld = L_Det and (L_Det:FindFirstChild("LeftWeld") or L_Det:FindFirstChild("RigidConstraint"))
                    local R_Weld = R_Det and (R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChild("RigidConstraint"))
                    if grab and drop and L_Weld and R_Weld then
                        pcall(function()
                            grab:FireServer(L_Det, tRoot, L_Weld)
                            grab:FireServer(R_Det, tRoot, R_Weld)
                            drop:FireServer(L_Weld, tRoot)
                            drop:FireServer(R_Weld, tRoot)
                        end)
                    end
                end
                if not dragging then
                    myRoot2.CFrame = tRoot.CFrame
                    if GE then
                        pcall(function()
                            tHum.PlatformStand = true
                            if GE.SetNetworkOwner then GE.SetNetworkOwner:FireServer(tRoot, myRoot2.CFrame) end
                            if GE.CreateGrabLine then GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false) end
                        end)
                    end
                    if grabStartTime == 0 then grabStartTime = tick() end
                    if tick() - grabStartTime > 0.3 then
                        dragging = true
                        grabStartTime = 0
                    end
                else
                    local lockPos = savedPos * CFrame.new(0, kickHeight, 0)
                    myRoot2.CFrame = savedPos
                    tRoot.CFrame = lockPos
                    if GE then
                        pcall(function()
                            tHum.PlatformStand = true
                            if GE.SetNetworkOwner then GE.SetNetworkOwner:FireServer(tRoot, lockPos) end
                            if GE.DestroyGrabLine then GE.DestroyGrabLine:FireServer(tRoot) end
                            if GE.CreateGrabLine then GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false) end
                        end)
                    end
                end
            else
                dragging = false
                grabStartTime = 0
            end
            task.wait()
        end
        if myRoot and savedPos then myRoot.CFrame = savedPos end
        kickLoopEnabled = false
    end)
end

function stopLoopKickBlob()
    kickLoopEnabled = false
end

function startSpinLoopKick(target)
    spinLoopActive = true
    spinAngle = 0
    if not target then spinLoopActive = false return end
    if spinLoopTask then task.cancel(spinLoopTask) spinLoopTask = nil end
    spinLoopTask = task.spawn(function()
        local GE = ReplicatedStorage:FindFirstChild("GrabEvents")
        while spinLoopActive and _G.BlobApplyActive do
            if not target or not target.Parent or not target.Character then spinLoopActive = false break end
            local myChar = LocalPlayer.Character
            if not myChar then task.wait(0.5) continue end
            local myRoot = myChar:FindFirstChild("HumanoidRootPart")
            if not myRoot then task.wait(0.5) continue end
            local tChar = target.Character
            local tRoot = tChar:FindFirstChild("HumanoidRootPart")
            local tHum = tChar:FindFirstChild("Humanoid")
            local seat = myChar.Humanoid and myChar.Humanoid.SeatPart
            if tRoot and tHum and tHum.Health > 0 then
                tRoot.AssemblyLinearVelocity = Vector3.zero
                tRoot.Velocity = Vector3.zero
                if seat then
                    local blobman = seat.Parent
                    local remoteFolder = blobman:FindFirstChild("BlobmanSeatAndOwnerScript")
                    local grab = remoteFolder and remoteFolder:FindFirstChild("CreatureGrab")
                    local drop = remoteFolder and remoteFolder:FindFirstChild("CreatureDrop")
                    local L_Det = blobman:FindFirstChild("LeftDetector")
                    local R_Det = blobman:FindFirstChild("RightDetector")
                    local L_Weld = L_Det and (L_Det:FindFirstChild("LeftWeld") or L_Det:FindFirstChild("RigidConstraint"))
                    local R_Weld = R_Det and (R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChild("RigidConstraint"))
                    if grab and drop and L_Weld and R_Weld then
                        pcall(function()
                            grab:FireServer(L_Det, tRoot, L_Weld)
                            grab:FireServer(R_Det, tRoot, R_Weld)
                            drop:FireServer(L_Weld, tRoot)
                            drop:FireServer(R_Weld, tRoot)
                        end)
                    end
                end
                spinAngle = spinAngle + spinSpeed
                if spinAngle > 6.28 then spinAngle = 0 end
                local x = math.cos(spinAngle) * spinRadius
                local z = math.sin(spinAngle) * spinRadius
                myRoot.CFrame = tRoot.CFrame * CFrame.new(x, 0, z)
                if GE then
                    pcall(function()
                        tHum.PlatformStand = true
                        if GE.SetNetworkOwner then GE.SetNetworkOwner:FireServer(tRoot, myRoot.CFrame) end
                        if GE.CreateGrabLine then GE.CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false) end
                    end)
                end
            end
            task.wait()
        end
        spinLoopActive = false
    end)
