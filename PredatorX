end

function startBring(target)
    if bringTask then task.cancel(bringTask) bringTask = nil end
    bringTask = task.spawn(function()
        while bringActive and _G.BlobApplyActive and target and target.Parent do
            local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local humanoid = char:FindFirstChild("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local seat = humanoid and humanoid.SeatPart
            if not (char and humanoid and hrp and seat) then task.wait(0.5) continue end
            local seatParent = seat.Parent
            if not seatParent or seatParent.Name ~= "CreatureBlobman" then task.wait(0.5) continue end
            local targetChar = target.Character or target.CharacterAdded:Wait()
            local targetHumanoid = targetChar:FindFirstChild("Humanoid")
            local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
            if not (targetHumanoid and targetHRP) or targetHumanoid.Health <= 0 then task.wait(0.5) continue end
            local leftDet = seatParent:FindFirstChild("LeftDetector")
            local rightDet = seatParent:FindFirstChild("RightDetector")
            local leftWeld = leftDet and leftDet:FindFirstChild("LeftWeld")
            local rightWeld = rightDet and rightDet:FindFirstChild("RightWeld")
            if not (leftDet and rightDet and leftWeld and rightWeld) then task.wait(0.5) continue end
            local script = seatParent:FindFirstChild("BlobmanSeatAndOwnerScript")
            local grab = script and script:FindFirstChild("CreatureGrab")
            local drop = script and script:FindFirstChild("CreatureDrop")
            if not (grab and drop) then task.wait(0.5) continue end
            local originalCFrame = hrp.CFrame
            hrp.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 2.5)
            task.wait(0.1)
            grab:FireServer(leftDet, targetHRP, leftWeld)
            task.wait(0.05)
            grab:FireServer(rightDet, targetHRP, rightWeld)
            task.wait(0.05)
            grab:FireServer(leftDet, targetHRP, leftWeld)
            task.wait(0.05)
            grab:FireServer(rightDet, targetHRP, rightWeld)
            task.wait(0.05)
            local startTime = tick()
            while tick() - startTime < 1.5 and bringActive and _G.BlobApplyActive and target and target.Parent do
                if targetHRP and targetHRP.Parent then
                    targetHRP.CFrame = hrp.CFrame * CFrame.new(0, 0, 3)
                    targetHRP.AssemblyLinearVelocity = Vector3.zero
                    targetHRP.AssemblyAngularVelocity = Vector3.zero
                end
                task.wait()
            end
            drop:FireServer(leftWeld, targetHRP)
            task.wait(0.05)
            drop:FireServer(rightWeld, targetHRP)
            task.wait(0.05)
            hrp.CFrame = originalCFrame
            task.wait(0.5)
        end
    end)
end

