-- ═══════════════════════════════════════════════════════════════
-- Window:Notify({ Title = "Hello", Text = "World", Duration = 3, Icon = 123 })
function PredatorUI:Notify(opts)
    if type(opts) == "string" then opts = { Title = opts } end
    opts = opts or {}

    local title    = opts.Title or "Notification"
    local text     = opts.Text or opts.Content or ""
    local duration = opts.Duration or 3
    local iconId   = parseIcon(opts.Icon)

    local notif = create("Frame", {
        Size = UDim2.new(1, 0, 0, text ~= "" and 60 or 44),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
        Parent = self.NotifyContainer,
    })
    corner(notif, 12)
    stroke(notif, Theme.Border, 1.5, 0.3)

    -- // Accent bar ด้านซ้าย
    local accentBar = create("Frame", {
        Size = UDim2.new(0, 4, 0.7, 0),
        Position = UDim2.new(0, 0, 0.15, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = notif,
    })
    corner(accentBar, 2)
    gradient(accentBar, Theme.Accent, Theme.AccentAlt, 90)

    -- // Icon
    if iconId then
        create("ImageLabel", {
            Size = UDim2.new(0, 20, 0, 20),
            Position = UDim2.new(0, 14, 0, 12),
            BackgroundTransparency = 1,
            Image = iconId,
            ImageColor3 = Theme.Accent,
            Parent = notif,
        })
    end

    local textLeft = iconId and 42 or 14

    create("TextLabel", {
        Size = UDim2.new(1, -textLeft - 14, 0, 20),
        Position = UDim2.new(0, textLeft, 0, 8),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Theme.Text,
        Font = FontBold,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = notif,
    })

    if text ~= "" then
        create("TextLabel", {
            Size = UDim2.new(1, -textLeft - 14, 0, 24),
            Position = UDim2.new(0, textLeft, 0, 28),
            BackgroundTransparency = 1,
            Text = text,
            TextColor3 = Theme.TextDim,
            Font = Font,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true,
            Parent = notif,
        })
    end

    -- // Animation เข้า
    local startX = (self.NotifySide == "Left") and -320 or 320
    notif.Position = UDim2.new(0, startX, 0, 0)
    notif.Visible = true

    tween(notif, 0.3, {Position = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Quart)

    -- // Animation ออก
    task.delay(duration, function()
        if notif and notif.Parent then
            tween(notif, 0.3, {Position = UDim2.new(0, startX, 0, 0)}, Enum.EasingStyle.Quart)
            task.wait(0.3)
            if notif and notif.Parent then
                notif:Destroy()
            end
        end
    end)

    return notif
end
