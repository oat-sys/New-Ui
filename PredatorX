                Notify("Ragnith", "Ragdoll enabled", "Info", "solar/danger-triangle-bold", 3)
                Options["LoopRagdoll"]:SetValue(false)
                return
            end

            Players = game:GetService("Players")
            Workspace = game:GetService("Workspace")
            ReplicatedStorage = game:GetService("ReplicatedStorage")
            LocalPlayer = Players.LocalPlayer

            function sno(part)
                pcall(function()
                    ReplicatedStorage.GrabEvents.SetNetworkOwner:FireServer(part, part.CFrame)
                end)
            end

            function spawntoy(toy, cf)
                if not LocalPlayer.CanSpawnToy.Value then
                    LocalPlayer.CanSpawnToy.Changed:Wait()
                end
                local t
                inv = Workspace:FindFirstChild(LocalPlayer.Name .. 'SpawnedInToys')
                if not inv then return end
                toyadded = inv.ChildAdded:Connect(function(c)
                    if c.Name == toy then
                        t = c
                        toyadded:Disconnect()
                    end
                end)
                task.spawn(function()
                    ReplicatedStorage.MenuToys.SpawnToyRemoteFunction:InvokeServer(toy, cf, Vector3.new(0, 0, 0))
                end)
                timeout = tick() + 1
                repeat task.wait() until t or tick() > timeout
                if t then return t end
            end

            PalletForRagdoll = nil

            function spawnragdoll()
                char = LocalPlayer.Character
                HRP = char and char:FindFirstChild("HumanoidRootPart")
                if not HRP then return end

                PalletForRagdoll = spawntoy('PalletLightBrown', HRP.CFrame * CFrame.new(0, 10, 20))
                if not PalletForRagdoll then return end

                repeat task.wait() until PalletForRagdoll and PalletForRagdoll:FindFirstChild('SoundPart')
                repeat
                    task.wait()
                    sno(PalletForRagdoll.SoundPart)
                until PalletForRagdoll.SoundPart:FindFirstChild('PartOwner')

                PalletForRagdoll.SoundPart.AssemblyLinearVelocity = Vector3.new(0, 1e9, 0)
                for _, v in pairs(PalletForRagdoll:GetChildren()) do
                    if v:IsA('Part') then
                        v.CanCollide = false
                        v.CanQuery = false
                        v.Transparency = 1
                    end
                end
                PalletForRagdoll.Name = 'PalletForRagdoll'
                cons.PalletDestroying = PalletForRagdoll.Destroying:Once(function()
                    spawnragdoll()
                end)
            end

            spawnragdoll()

            task.spawn(function()
                while loopragdoll and task.wait(0.05) do
                    tChar = SelectedTarget.Character
                    if tChar and tChar:FindFirstChild("Humanoid") and tChar.Humanoid.Ragdolled and not tChar.Humanoid.Ragdolled.Value and PalletForRagdoll and PalletForRagdoll:FindFirstChild('SoundPart') then
                        tRoot = tChar:FindFirstChild("HumanoidRootPart")
                        if tRoot then
                            PalletForRagdoll.SoundPart.AssemblyLinearVelocity = Vector3.new(0, 1000, 0)
                            PalletForRagdoll.SoundPart.CFrame = tRoot.CFrame
                            task.wait(0.05)
                            PalletForRagdoll.SoundPart.CFrame = CFrame.new(0, 1e9, 0)
                        end
                    end
                end
            end)
        else
            if cons.PalletDestroying then
                cons.PalletDestroying:Disconnect()
                cons.PalletDestroying = nil
            end
            inv = Workspace:FindFirstChild(LocalPlayer.Name .. 'SpawnedInToys')
            if inv and inv:FindFirstChild('PalletForRagdoll') then
                ReplicatedStorage.MenuToys.DestroyToy:FireServer(inv.PalletForRagdoll)
            end
            Notify("Ragnith", "Ragdoll Disable", "Info", "solar/danger-triangle-bold", 3)
        end
    end
})

function RemoveAntiKickFunction(targetName)
    SetNetOwner = ReplicatedStorage.GrabEvents.SetNetworkOwner
    LocalPlayer = game.Players.LocalPlayer

    function invis_touch(part, cf)
        SetNetOwner:FireServer(part, cf)
    end

    function CheckAndYeet(toy)
        part = toy:FindFirstChild("SoundPart")
        if part then
            invis_touch(part, part.CFrame)
            if part:FindFirstChild("PartOwner") and part.PartOwner.Value == LocalPlayer.Name then
                part.CFrame = CFrame.new(0, 1000, 0)
            end
        end
    end

    while antiAntiKickActive do
        target = game.Players:FindFirstChild(targetName)
        if target then
            spawned = workspace:FindFirstChild(target.Name .. "SpawnedInToys")
            if spawned then
                if spawned:FindFirstChild("NinjaKunai") then
                    CheckAndYeet(spawned.NinjaKunai)
                end
                if spawned:FindFirstChild("NinjaShuriken") then
                    CheckAndYeet(spawned.NinjaShuriken)
                end
                if spawned:FindFirstChild("AntiKick") then
                    CheckAndYeet(spawned.AntiKick)
                end
            end
        end
        task.wait(0.1)
    end
end

