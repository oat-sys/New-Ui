            if bp then
                bp:Destroy()
            end
            if bg then
                bg:Destroy()
            end
            if h then
                h:Destroy()
            end
        end
    end

    CleanConns(AnchorConns)
    table.clear(AnchorParts)
end
function ApplyAnchor(v)
