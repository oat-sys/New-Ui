function PredatorUI:_makeCard(group, height)
    local card = create("Frame", {
        Size = UDim2.new(1, -4, 0, height or 36),
        BackgroundColor3 = Theme.CardBg,
        BackgroundTransparency = Transparency.CardBg,
        BorderSizePixel = 0,
        Parent = group.Content,
    })
    corner(card, 10)
    stroke(card, Theme.Border, 1, 0.3)
