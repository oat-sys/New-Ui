-- Library:CreateWindow({...})
function PredatorUI:CreateWindow(opts)
    opts = opts or {}

    local window = setmetatable({}, PredatorUI)
    window.Title       = opts.Title       or "PredatorUI"
    window.Footer      = opts.Footer      or "version: " .. PredatorUI.Version
    window.Icon        = parseIcon(opts.Icon) or "rbxassetid://7733960979"
    window.NotifySide  = opts.NotifySide  or "Right"
    window.ToggleKey   = opts.ToggleKey   or Enum.KeyCode.RightShift
    window.Size        = opts.Size        or UDim2.new(0, 720, 0, 500)
    window.Position    = opts.Position    or UDim2.new(0.5, -360, 0.5, -250)

    window.Tabs        = {}
    window.ActiveTab   = nil
    window.Flags       = {}
    window.Connections = {}
    window.Notifications = {}
    window.IsOpen      = true
    window.Minimized   = false

    window:_buildWindow()
    window:_bindToggleKey()

    return window
end

