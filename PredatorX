-- ▓▓▓ DESTROY / CLEANUP ▓▓▓
-- ═══════════════════════════════════════════════════════════════
function PredatorUI:Destroy()
    for _, c in ipairs(self.Connections) do
        if c and c.Disconnect then pcall(function() c:Disconnect() end) end
    end
    if self.Gui then
        self.Gui:Destroy()
    end
end

function PredatorUI:SetToggleKey(key)
    self.ToggleKey = key
end

