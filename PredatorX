-- // ────────── TOGGLE / CHECKBOX ──────────
-- group:AddToggle({ Name="Aimbot", Default=false, Callback=fn })
-- group:AddToggle({ Name="Aimbot", Style="Checkbox", ... })
function PredatorUI:AddToggle(group, opts)
    if type(opts) == "string" then opts = { Name = opts } end
    opts = opts or {}

    local name    = opts.Name or "Toggle"
    local default = opts.Default or false
    local callback= opts.Callback
    local iconId  = parseIcon(opts.Icon)
    local style   = opts.Style or "Toggle" -- "Toggle" หรือ "Checkbox"
    local flag    = opts.Flag or name

    self.Flags[flag] = default

    local card = self:_makeCard(group, 36)

    if iconId then
        self:_makeIcon(card, iconId, Theme.Accent)
    end

    self:_makeLabel(card, name, iconId ~= nil)

    -- // Click Area
    local clickArea = create("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        Parent = card,
    })

    local state = default

    if style == "Checkbox" then
        -- ── Checkbox สี่เหลี่ยม
        local box = create("Frame", {
            Size = UDim2.new(0, 20, 0, 20),
            Position = UDim2.new(1, -30, 0.5, -10),
            BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(230, 230, 240),
            BackgroundTransparency = state and 0 or 0.3,
            BorderSizePixel = 0,
            Parent = card,
        })
        corner(box, 6)
        stroke(box, state and Theme.Accent or Theme.BorderDim, 1.5, 0)

        local check = create("TextLabel", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            Text = "✓",
            TextColor3 = Color3.fromRGB(255, 255, 255),
            Font = FontBold,
            TextSize = 14,
            TextTransparency = state and 0 or 1,
            Parent = box,
        })

        local function setState(s)
            state = s
            self.Flags[flag] = s
            tween(box, 0.2, {
                BackgroundColor3 = s and Theme.Accent or Color3.fromRGB(230, 230, 240),
                BackgroundTransparency = s and 0 or 0.3,
            })
            tween(box.UIStroke, 0.2, {
                Color = s and Theme.Accent or Theme.BorderDim,
            })
            tween(check, 0.2, {TextTransparency = s and 0 or 1})
            if callback then task.spawn(callback, s) end
        end

        clickArea.MouseButton1Click:Connect(function()
            setState(not state)
        end)

        return {
            Frame = card,
            Set = setState,
            Get = function() return state end,
        }

    else
        -- ── Toggle สวิตช์
        local track = create("Frame", {
            Size = UDim2.new(0, 38, 0, 20),
            Position = UDim2.new(1, -50, 0.5, -10),
            BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(230, 230, 240),
            BackgroundTransparency = state and 0 or 0.3,
            BorderSizePixel = 0,
            Parent = card,
        })
        corner(track, 10)

        local knob = create("Frame", {
            Size = UDim2.new(0, 14, 0, 14),
            Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BorderSizePixel = 0,
            Parent = track,
        })
        corner(knob, 7)

        local function setState(s)
            state = s
            self.Flags[flag] = s
            tween(track, 0.2, {
                BackgroundColor3 = s and Theme.Accent or Color3.fromRGB(230, 230, 240),
                BackgroundTransparency = s and 0 or 0.3,
            })
            tween(knob, 0.2, {
                Position = s and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
            })
            if callback then task.spawn(callback, s) end
        end

        clickArea.MouseButton1Click:Connect(function()
            setState(not state)
        end)

        return {
            Frame = card,
            Set = setState,
            Get = function() return state end,
        }
    end
end

-- // ────────── SLIDER ──────────
function PredatorUI:AddSlider(group, opts)
    if type(opts) == "string" then opts = { Name = opts } end
    opts = opts or {}

    local name    = opts.Name or "Slider"
    local min     = opts.Min or 0
    local max     = opts.Max or 100
    local default = opts.Default or min
    local suffix  = opts.Suffix or ""
    local callback= opts.Callback
    local iconId  = parseIcon(opts.Icon)
    local flag    = opts.Flag or name

    local card = self:_makeCard(group, 56)
    card.BackgroundTransparency = 0.5

    -- // Header Row
    local header = create("Frame", {
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.new(0, 10, 0, 6),
        BackgroundTransparency = 1,
        Parent = card,
    })

    if iconId then
        create("ImageLabel", {
            Size = UDim2.new(0, 14, 0, 14),
            Position = UDim2.new(0, 0, 0.5, -7),
            BackgroundTransparency = 1,
            Image = iconId,
            ImageColor3 = Theme.Accent,
            Parent = header,
        })
    end

    create("TextLabel", {
        Size = UDim2.new(0, 150, 1, 0),
        Position = UDim2.new(0, iconId and 22 or 0, 0, 0),
        BackgroundTransparency = 1,
        Text = name,
        TextColor3 = Theme.Text,
        Font = Font,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = header,
    })

    local valueLabel = create("TextLabel", {
        Size = UDim2.new(0, 60, 1, 0),
        Position = UDim2.new(1, -60, 0, 0),
        BackgroundTransparency = 1,
        Text = tostring(default) .. suffix,
        TextColor3 = Theme.Accent,
        Font = FontBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = header,
    })

    -- // Track
    local track = create("Frame", {
        Size = UDim2.new(1, -20, 0, 5),
        Position = UDim2.new(0, 10, 0, 38),
        BackgroundColor3 = Color3.fromRGB(200, 200, 220),
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Parent = card,
    })
    corner(track, 3)

    local fill = create("Frame", {
        Size = UDim2.new((default - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
        Parent = track,
    })
    corner(fill, 3)
    gradient(fill, Theme.Accent, Theme.AccentAlt, 0)

    local knob = create("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new((default - min) / (max - min), -6, 0.5, -6),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        Parent = track,
    })
    corner(knob, 6)
    stroke(knob, Theme.Accent, 2, 0)

    -- // Input Handling
    local dragging = false
    local currentValue = default

    local function setValue(value)
        value = math.clamp(value, min, max)
        currentValue = math.floor(value * 100 + 0.5) / 100
        local percent = (currentValue - min) / (max - min)
        fill.Size = UDim2.new(percent, 0, 1, 0)
        knob.Position = UDim2.new(percent, -6, 0.5, -6)
        valueLabel.Text = tostring(currentValue) .. suffix
        self.Flags[flag] = currentValue
        if callback then task.spawn(callback, currentValue) end
    end

    local function processInput(input)
        local pos = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
        setValue(min + (max - min) * pos)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            processInput(input)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            processInput(input)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return {
        Frame = card,
        Set = setValue,
        Get = function() return currentValue end,
    }
end

