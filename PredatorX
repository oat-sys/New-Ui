-- tab:CreateGroup({ Name = "Combat", Icon = 1234567, Side = "Left" })
function PredatorUI:CreateGroup(tab, opts)
    if type(opts) == "string" then
        opts = { Name = opts }
    end
    opts = opts or {}

    local gb = {
        Name   = opts.Name or "Group",
        Icon   = parseIcon(opts.Icon),
        Side   = opts.Side or "Left",
        Tab    = tab,
    }

    gb.Frame = create("Frame", {
        Name = "Group_" .. gb.Name,
        Size = UDim2.new(0.5, -5, 1, 0),
        BackgroundColor3 = Theme.GroupboxBg,
        BackgroundTransparency = Transparency.GroupboxBg,
        BorderSizePixel = 0,
        Parent = tab.Page,
    })
    corner(gb.Frame, 14)
    stroke(gb.Frame)

    -- // Header
    gb.Header = create("Frame", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BackgroundTransparency = 0.8,
        BorderSizePixel = 0,
        Parent = gb.Frame,
    })
    corner(gb.Header, 14)
    create("Frame", {
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0, 0, 1, -1),
        BackgroundColor3 = Theme.BorderDim,
        BackgroundTransparency = 0.7,
        BorderSizePixel = 0,
        Parent = gb.Header,
    })

    -- // Icon
    if gb.Icon then
        create("ImageLabel", {
            Size = UDim2.new(0, 16, 0, 16),
            Position = UDim2.new(0, 12, 0.5, -8),
            BackgroundTransparency = 1,
            Image = gb.Icon,
            ImageColor3 = Theme.Accent,
            Parent = gb.Header,
        })
    end

    -- // Title
    create("TextLabel", {
        Size = UDim2.new(1, -60, 1, 0),
        Position = UDim2.new(0, gb.Icon and 34 or 12, 0, 0),
        BackgroundTransparency = 1,
        Text = string.upper(gb.Name),
        TextColor3 = Theme.Text,
        Font = FontBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = gb.Header,
    })

    -- // Content (Scroll)
    gb.Content = create("ScrollingFrame", {
        Name = "Content",
        Size = UDim2.new(1, -16, 1, -46),
        Position = UDim2.new(0, 8, 0, 42),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = Theme.Accent,
        ScrollBarImageTransparency = 0.3,
        Parent = gb.Frame,
    })

    create("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = gb.Content,
    })

    -- // Auto CanvasSize
    local function updateCanvas()
        task.wait()
        local layout = gb.Content:FindFirstChildOfClass("UIListLayout")
        if layout then
            gb.Content.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
        end
    end
    gb.Content.ChildAdded:Connect(updateCanvas)
    gb.Content.ChildRemoved:Connect(updateCanvas)

    table.insert(tab.Groups, gb)

    -- // จัดเรียง groupbox ใหม่ให้มีขนาดเท่ากัน
    task.defer(function()
        local groups = {}
        for _, child in ipairs(tab.Page:GetChildren()) do
            if child:IsA("Frame") and child.Name:sub(1, 6) == "Group_" then
                table.insert(groups, child)
            end
        end
        local count = #groups
        for _, g in ipairs(groups) do
            g.Size = UDim2.new(1/count, -5, 1, 0)
        end
    end)

    return gb
end

